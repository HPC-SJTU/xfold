# NOTE: This script is the template for the environment variables used in the training script.
#       You may copy this file to `env.sh` and modify the variables as needed.

cd $(dirname "$0")

# Activate the conda environment
conda activate xfold

# Basic path settings
export JSON_PATH=/absolute/path/to/your/input/json
export MODEL_DIR=/absolute/path/to/your/model
export OUTPUT_DIR=$(pwd)/output
export LOG_DIR=${OUTPUT_DIR}/log
# Required for automatic accelerated preprocessing before run.sh/run_multi.sh.
export AF3_PREPROCESS_PYTHON=/absolute/path/to/af3-3.0.4/bin/python
export AF3_DB_DIR=/absolute/path/to/public_databases
# Optional: reuse a completed output instead of running preprocessing again.
# Must be accessible at the same absolute path on every MPI node.
# export XFOLD_PREPROCESSED_DIR=/absolute/path/to/preprocessed
mkdir -p ${LOG_DIR}
# export DO_PROFILE=1 # Uncomment to enable profiling
export CPU_PER_NUMA=$(lscpu | grep socket | cut -d ' ' -f 22)

# Distributed settings
export MASTER_PORT=1896
export MASTER_ADDR=localhost
export PPN=2
export NNODES=1
export NNODE_MPI=$(echo "${NNODES} * ${PPN}" | bc)
# export FI_PROVIDER=verbs # Uncomment if you have IB cards
export CCL_LOG_LEVEL=info
export CCL_ATL_SHM=1
export CCL_ATL_TRANSPORT=ofi
export CCL_WORKER_COUNT=2
export USE_BACKEND=ccl
export AVAIL_THREADS=$(echo "${CPU_PER_NUMA} - ${CCL_WORKER_COUNT}" | bc)

# Single node settings
export NCORES=${CPU_PER_NUMA}
export RANK=0
